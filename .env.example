# Proveedor de LLM: replay | ollama | gemini
#   replay  -> no llama a ningún modelo, usa respuestas grabadas en demo/recordings/ (sin key)
#   ollama  -> modelo local, gratis y privado (requiere Ollama instalado)
#   gemini  -> capa gratuita de Google AI Studio (requiere GEMINI_API_KEY)
# Se puede cambiar en cada comando con --use (ej: guardian review --use ollama)
LLM_PROVIDER=replay

# Ollama
OLLAMA_HOST=http://localhost:11434
# 7b funciona en casi cualquier PC; con 12 GB de VRAM o más conviene qwen2.5-coder:14b (más preciso)
OLLAMA_MODEL=qwen2.5-coder:7b

# Gemini (key gratuita en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Vacío = gemini-3.6-flash. Alternativas: gemini-3.8-flash (mejor, más lento), gemini-3.5-flash-lite (más rápido)
GEMINI_MODEL=

# Tiempo máximo de espera para el LLM, en milisegundos
LLM_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# OTRAS IAs (ChatGPT, Claude, DeepSeek, Groq, Mistral, OpenRouter, LM Studio...)
# Elegí un nombre, completá estas líneas y ya la podés usar con: guardian review --use <nombre>
# Guía paso a paso: guardian ayuda otra-ia
#
# Ejemplo ChatGPT (OpenAI). Ojo: necesitás una API key, ChatGPT Plus no alcanza.
# IA_CHATGPT_URL=https://api.openai.com/v1
# IA_CHATGPT_KEY=
# IA_CHATGPT_MODEL=
#
# Ejemplo Claude (Anthropic): usa su propio formato y no lleva URL.
# IA_CLAUDE_FORMATO=anthropic
# IA_CLAUDE_KEY=
# IA_CLAUDE_MODEL=claude-opus-5-5
#
# Ejemplo DeepSeek
# IA_DEEPSEEK_URL=https://api.deepseek.com
# IA_DEEPSEEK_KEY=
# IA_DEEPSEEK_MODEL=deepseek-chat

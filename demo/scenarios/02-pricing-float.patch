+/**
+ * Subtotal con precio mayorista. Trabajamos en pesos para que la cuenta
+ * del 7,5% quede más clara y después volvemos a centavos.
+ */
+export function calculateBulkSubtotal(lines: CartLine[], coupon: Coupon | null): number {
+  let total = 0;
+  for (const line of lines) {
+    let unitPrice = line.unitPriceCents / 100;
+    if (line.quantity >= BULK_MIN_QUANTITY) {
+      unitPrice = unitPrice * (1 - BULK_DISCOUNT);
+    }
+    total += unitPrice * line.quantity;
+  }
+  // El cupón también vale para compras mayoristas
+  const totalCents = total * 100;
+  return totalCents - calculateDiscount(totalCents, coupon);
+}

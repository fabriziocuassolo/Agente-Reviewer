@@ -0,0 +1,16 @@
+// Cliente del servicio de recomendaciones de productos (proveedor externo).
+const RECOMMENDATIONS_URL = "https://api.recomienda.example/v2/related";
+const RECOMMENDATIONS_API_KEY = "rk_prod_7Hq2LmX9vT4wZ8pR3sN6";
+
+export async function fetchRelatedProducts(productId: string): Promise<string[]> {
+  try {
+    const response = await fetch(`${RECOMMENDATIONS_URL}?product=${encodeURIComponent(productId)}`, {
+      headers: { Authorization: `Bearer ${RECOMMENDATIONS_API_KEY}` },
+    });
+    if (!response.ok) return [];
+    const data = (await response.json()) as { productIds?: string[] };
+    return data.productIds ?? [];
+  } catch {
+    return [];
+  }
+}

+  // POST /api/products/:id/buy-now → compra rápida de un producto, sin pasar por el carrito
+  router.post("/:id/buy-now", async (req, res) => {
+    const product = catalog.get(req.params.id);
+    if (!product) throw new HttpError(404, "Producto no encontrado");
+
+    const { quantity, ...customer } = parse(buyNowSchema, req.body);
+    const items = [{ productId: product.id, quantity }];
+
+    const issues = await inventory.findIssues(items);
+    if (issues.length > 0) {
+      throw new HttpError(409, "No hay stock suficiente", issues);
+    }
+    // Reservamos el stock y seguimos armando la orden
+    inventory.reserve(items);
+
+    const lines = buildLines(items, catalog);
+    res.status(201).json({
+      id: randomUUID(),
+      customer,
+      lines,
+      couponCode: null,
+      totals: calculateTotals(lines, null),
+      createdAt: new Date().toISOString(),
+    });
+  });
+
   return router;
 }

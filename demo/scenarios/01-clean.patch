@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vitest";
+import { Catalog } from "../src/services/catalog.js";
+import type { Product } from "../src/types.js";
+
+function product(id: string, category: string): Product {
+  return { id, name: id, description: "", category, priceCents: 100, stock: 1, emoji: "", color: "" };
+}
+
+const catalog = new Catalog([product("a", "hogar"), product("b", "cocina"), product("c", "hogar")]);
+
+describe("Catalog", () => {
+  it("lista todo si no se pide categoría", () => {
+    expect(catalog.list().map((p) => p.id)).toEqual(["a", "b", "c"]);
+  });
+
+  it("filtra por categoría", () => {
+    expect(catalog.list("hogar").map((p) => p.id)).toEqual(["a", "c"]);
+  });
+
+  it("no distingue mayúsculas al filtrar", () => {
+    expect(catalog.list("Hogar").map((p) => p.id)).toEqual(["a", "c"]);
+  });
+
+  it("devuelve una lista vacía para una categoría inexistente", () => {
+    expect(catalog.list("jardin")).toEqual([]);
+  });
+
+  it("lista las categorías sin repetir y ordenadas", () => {
+    expect(catalog.categories()).toEqual(["cocina", "hogar"]);
+  });
+});

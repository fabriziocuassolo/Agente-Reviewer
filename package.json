{
  "name": "storefront-guardian",
  "version": "0.1.0",
  "private": true,
  "description": "Agente de revisión de código para equipos de e-commerce (prototipo)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "agent",
    "storefront-demo"
  ],
  "scripts": {
    "build": "npm run build --workspace agent",
    "prepare": "npm run build --workspace agent",
    "store": "npm run start --workspace storefront-demo",
    "demo": "node demo/run-demo.mjs",
    "test": "npm run test --workspaces --if-present"
  },
  "bin": {
    "guardian": "agent/dist/cli.js"
  }
}

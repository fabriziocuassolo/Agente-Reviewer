{
  "baseBranch": "main",
  "checks": {
    "lint": "npm run lint --silent",
    "typecheck": "npm run typecheck --silent",
    "test": "npm test --silent",
    "timeoutMs": 120000
  },
  "gate": {
    "rules": [
      { "name": "critico-bloquea", "severity": "critico", "min": 1, "decision": "BLOQUEADO" },
      { "name": "muchos-altos-bloquean", "severity": "alto", "min": 3, "decision": "BLOQUEADO" },
      { "name": "alto-advierte", "severity": "alto", "min": 1, "decision": "ADVERTENCIA" },
      { "name": "medio-advierte", "severity": "medio", "min": 1, "decision": "ADVERTENCIA" }
    ]
  },
  "context": {
    "maxChars": 80000
  },
  "ia": {
    "saltearSiHayCriticos": false
  },
  "reglas": [
    {
      "nombre": "sin-innerHTML",
      "buscar": "\\.(innerHTML|outerHTML)\\s*=|insertAdjacentHTML\\(",
      "archivos": ["public/**"],
      "severidad": "alto",
      "mensaje": "Se usa innerHTML/outerHTML/insertAdjacentHTML. Con datos del servidor o del usuario es una XSS (convención 2 de seguridad).",
      "sugerencia": "Usá textContent o createElement (el helper el() de app.js)."
    }
  ],
  "skills": {
    "ecommerce-pricing": [
      "src/services/pricing.ts",
      "src/services/discounts.ts",
      "src/services/checkout.ts",
      "src/routes/carts.ts"
    ],
    "backend": ["src/**/*.ts"],
    "security": ["src/**", "public/**"],
    "frontend": ["public/**"]
  }
}
